<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR-0001: EF Core 10 code-first migrations, Npgsql provider (PostgreSQL 17). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Development-only local mode (docs/development/local-dev.md): file-backed SQLite
         via Database:Provider=Sqlite. Production stays PostgreSQL (ADR-0001). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- Pin past the vulnerable transitive 2.1.11 native bundle (NU1903), same as the test project. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <!-- ADR-0001: Entra ID OIDC via Microsoft.Identity.Web (wired in the identity
         integration task, Phase 1 backlog; declared here so the dependency is decided). -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- Pins the transitive version from Microsoft.Identity.Web past GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <!-- ADR-0012 (K6): the OpenAPI document the PWA's types are generated from.
         Built-in .NET 10 generator — no Swashbuckle/NSwag. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Pin past the vulnerable transitive 2.0.0 (NU1903) that Microsoft.AspNetCore.OpenApi
         10.0.0 resolves to — 2.8.0 is the first advisory-clean release. Same
         pattern as the SQLitePCLRaw pin above. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

</Project>
