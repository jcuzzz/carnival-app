<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Runtime-skippable facts: Testcontainers tests skip when Docker is absent
         (this dev machine has no Docker; they run in CI/VM). -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <!-- Local relational integration tests (promotion, state machine) run on
         SQLite in-memory; the schema itself is provider-clean by ADR-0001. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- In-process HTTP tests (authorisation, idempotency demo endpoint). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Real-database tests: migrations + transactionality on PostgreSQL 17. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- Pin past the vulnerable transitive SSH.NET 2024.2.0 (GHSA-q939-rpr3-3284)
         that Testcontainers still resolves; same pattern as the pins above. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CarnivalApp.Api\CarnivalApp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Synthetic fixtures only (repo hard rule: never real student data). -->
    <Content Include="..\..\..\data\synthetic\ST_CLEAN.csv" Link="Fixtures\ST_CLEAN.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\data\synthetic\ST_SYNTH.csv" Link="Fixtures\ST_SYNTH.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\config\import-mapping.example.json" Link="Fixtures\import-mapping.example.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Event templates are tested against the REAL shipped documents so the
         template/derivation label agreement is asserted on what deploys. -->
    <Content Include="..\..\..\config\event-templates\*.json" Link="Fixtures\event-templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
