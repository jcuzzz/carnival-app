# Per-school deployment settings (proposal §7.3). Copy to .env and fill in.
# NEVER commit a real .env — .gitignore excludes it.

# Compose project name = school isolation boundary (one project per school)
COMPOSE_PROJECT_NAME=carnival-app-example-college

# School
SCHOOL_NAME=Example Synthetic College
SCHOOL_TIMEZONE=Australia/Melbourne
# Optional brand colour (ADR-0040 §3), #rrggbb or #rgb. Leave empty for the
# neutral default palette; a colour the API cannot parse stops it starting.
SCHOOL_BRAND_COLOUR=
# Houses (configuration data, proposal §7.3): used by import house validation
# and event/demo seeding. Compose passes these as School__Houses__0..3; a
# school with more/fewer houses edits the compose block accordingly.
SCHOOL_HOUSE_1=BANKSIA
SCHOOL_HOUSE_2=WATTLE
SCHOOL_HOUSE_3=MOUNTAIN ASH
SCHOOL_HOUSE_4=GREVILLEA
# Optional house colours (ADR-0044 §2), #rrggbb or #rgb, passed as
# School__HouseColours__<CODE> (see docker-compose.yml — add one line per house).
# Leave empty for text-only houses; an unparseable value, or one repeating
# another house's colour, is dropped with a warning rather than stopping the API.
SCHOOL_HOUSE_1_COLOUR=

# Container images (ADR-0049). CI builds all four on every green push to main
# and pushes them to GHCR; this VM only ever pulls. LEAVE THESE EMPTY on a
# first stand-up (the :main tag is the compose default) — the deploy script
# WRITES DIGEST PINS, e.g.
#   API_IMAGE=ghcr.io/jcuzzz/carnival-app-api@sha256:...
# for the exact commit being deployed (rewritten each deploy, at the END of
# .env, under a "Digest pins written by vm-deploy.sh" line), and saves the
# previous pins to
# ~/pins-<utcdate>-<oldsha>.env so a rollback is one `docker compose up -d`.
# Tags are for humans; digests are what runs. Demo mode is a different IMAGE
# (carnival-app-web-demo), never a runtime flag — see VITE_DEMO_MODE below.
# Local development builds instead of pulling:
#   docker compose -f docker-compose.yml -f docker-compose.build.yml up --build
API_IMAGE=
WEB_IMAGE=
BACKUP_IMAGE=

# GHCR read credential. The packages are private, so the VM needs a token to
# pull: a fine-grained PAT scoped to this repo's packages (read), or a classic
# PAT with `read:packages` AND NOTHING ELSE. This is the school holding a
# credential INTO GitHub — the reverse (GitHub holding a key into school
# infrastructure) stays forbidden, which is why there is no push-based deploy.
# Used ONCE per VM, then Docker's credential store keeps it:
#   printf '%s' "$GHCR_READ_TOKEN" | docker login ghcr.io -u <github-user> --password-stdin
# Keep the values here only so a rotation has somewhere to live (.env is mode
# 600 and git-ignored). NEVER commit a token. The PAT expires: put its expiry
# on the per-term checklist beside the restore drill — expired, it fails the
# pull loudly at deploy time, not at run time.
GHCR_USER=
GHCR_READ_TOKEN=

# Import mapping inside the api container. The repo ./config directory is
# mounted read-only at /config (docker-compose.yml), which also provides the
# event templates at /config/event-templates.
IMPORT_MAPPING_PATH=/config/import-mapping.example.json

# Database — the OWNER role. Owns the schema and runs migrations only (ADR-0047 §3).
POSTGRES_DB=carnival
POSTGRES_USER=carnival
POSTGRES_PASSWORD=change-me-per-school
# The APPLICATION role: what every request runs as. CONNECT + DML, no DDL, and
# no UPDATE/DELETE on AuditEvents. Created and re-granted by
# deploy/db/init-roles.sql, which scripts/deploy/vm-deploy.sh runs each deploy —
# a stack brought up without it has no such role and the api cannot connect.
APP_DB_USER=carnival_app
APP_DB_PASSWORD=change-me-per-school-too
# Apply EF migrations on startup. true for first stand-up / the synthetic test
# VM; production upgrades use backup-gated migration bundles (ADR-0001).
APPLY_MIGRATIONS=false

# Entra ID (per-school app registration; secret from ICT, not source control)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Entra sign-in authority; leave empty for the public cloud (https://login.microsoftonline.com/).
ENTRA_INSTANCE=
# ADFS instead of Entra: leave the ENTRA_* values empty and copy the Adfs block
# from docker-compose.override.example.yml.
# In-app roles (ADR-0048): UPN of a bootstrap SystemAdministrator, read on every
# request; comma-separate several. Leave empty when an Entra group already maps
# to SystemAdministrator.
BOOTSTRAP_ADMIN_UPN=

# Dev header authentication — keep false. Honoured only by an API running with
# ASPNETCORE_ENVIRONMENT=Development and no Entra/ADFS configured, where anyone
# who can reach it could assume any role via X-Dev-Subject/X-Dev-Roles headers.
DEV_AUTH=false
# Build-time frontend flag, so on the VM a choice of image: true pins
# ghcr.io/jcuzzz/carnival-app-web-demo, the public-demo build (DEMO MODE banner,
# landing page, demo session cookie), which works only against a demo host
# (ADR-0061), never a school stack. false pins carnival-app-web. Locally it is the
# build overlay's build arg.
VITE_DEMO_MODE=false

# Proxy / TLS. Public hostname → Caddy auto-ACME; internal host → use
# "internal" TLS or ICT-supplied certificates (ADR-0001 review note 3).
SITE_ADDRESS=localhost
# Caddy certificate source: internal (Caddy's own CA), "<cert> <key>" paths
# (mount them; see the proxy service in docker-compose.yml), or an email for ACME.
TLS_MODE=internal

# Backups (ADR-0047 §4). Every dump is encrypted to an age recipient before it
# reaches the volume; the matching PRIVATE key is held by the school OFF this
# VM (a lost key means unreadable backups — key custody is in the runbook).
# Generate a keypair with `age-keygen -o school-backup.key` on a trusted
# machine and paste the "Public key: age1..." line here.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=
# DEMO-ONLY TOGGLE — same tone as DEV_AUTH above. "off" writes PLAINTEXT dumps
# of the whole database to the volume and MUST NEVER be used with real student
# data; it exists so a synthetic test VM can stand up before a key exists.
# Anything other than "off" (the default) requires BACKUP_AGE_RECIPIENT, and the
# backup container refuses to start without one.
BACKUP_ENCRYPTION=on
# Optional off-host copy target for scripts/deploy/push-backups.sh: any rsync
# -over-ssh destination the deploy account can reach without a passphrase,
# e.g. backups@nas.school.internal:/srv/carnival-app/carnival-app-host. Unset = the
# script is a no-op and the encrypted dumps stay on the one disk (assessment B6).
BACKUP_PUSH_TARGET=

ASPNETCORE_ENVIRONMENT=Production
